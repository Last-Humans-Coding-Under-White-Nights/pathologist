# Doxyfile for trace C API documentation

PROJECT_NAME           = "trace"
PROJECT_NUMBER         = "0.1.0"
PROJECT_BRIEF          = "C API for the trace static-analysis engine"

OUTPUT_DIRECTORY       = target/doxygen
INPUT                  = crates/trace-capi/include/trace.h docs/CAPI.md
USE_MDFILE_AS_MAINPAGE = docs/CAPI.md

OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
SORT_MEMBER_DOCS       = NO

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = crates/trace-capi/include

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES

JAVADOC_AUTOBRIEF      = YES
